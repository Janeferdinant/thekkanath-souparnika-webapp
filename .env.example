# Thekkanath Souparnika Environment Configuration
# Copy this file to .env and configure your production or staging credentials.
# The application automatically runs in Local Demo Mode when credentials are empty.

# Supabase Backend Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-browser-safe-anon-key

# Venue Timezone
VITE_VENUE_TIMEZONE=Asia/Kolkata

# Official Venue Contacts
VITE_PRIMARY_PHONE=8129764370
VITE_SECONDARY_PHONE=9446143165
VITE_WHATSAPP_PHONE=918129764370
VITE_VENUE_EMAIL=thekkanathsouparnika@gmail.com

# External Integration Adapters (Optional - leaving blank uses safe fallback states)
# Google Maps Embed API
VITE_GOOGLE_MAPS_API_KEY=

# Email Delivery Provider (e.g. Resend / SendGrid / Postmark)
VITE_EMAIL_PROVIDER_API_KEY=
VITE_EMAIL_FROM_ADDRESS=notifications@thekkanath.com

# Payment Gateway (e.g. Razorpay / Cashfree) - Disabled until configured
VITE_PAYMENT_GATEWAY_KEY_ID=

# AI Copilot Service (e.g. Gemini / OpenAI) - Deterministic fallback used when empty
VITE_AI_API_KEY=
